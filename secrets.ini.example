; Copy to secrets.ini (gitignored) and fill in. Read by platformio.ini.
;
; Put every value except mqtt_port in DOUBLE QUOTES. PlatformIO keeps the
; quotes, so the value is already a C string literal when platformio.ini passes
; it to the compiler. Values pass through the shell, so they must not contain
;  "  '  \  $  `  or  ;  and no # after a space (it starts a comment)
[secrets]
wifi_ssid         = "your-network"
wifi_pass         = "your-password"

; MQTT broker. Anonymous access; no username or password needed.
mqtt_host         = "192.168.1.11"
mqtt_port         = 1883                      ; bare number, no quotes

; The room this panel shows, and the two topics carrying its reading. This
; board has no temperature sensor of its own, so the indoor reading always
; comes from the broker. The label is printed under the reading. Temperature
; must be the CELSIUS topic: the firmware stores Celsius and converts only for
; display.
indoor_label      = "Office"
mqtt_topic_temp   = "MarkOffice/DHT/tempc"
mqtt_topic_hum    = "MarkOffice/DHT/hum"

; Maple Valley, WA, the same coordinates the 7-inch panels use.
outdoor_label     = "Maple Valley"
weather_latitude  = "47.3673"
weather_longitude = "-122.0437"

; Over-the-air updates: the mDNS name (without .local) and the espota password.
device_host       = "epaper-display"
ota_password      = "a-long-password"
